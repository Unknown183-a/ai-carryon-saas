diff --git a/.github/workflows/deploy.yml b/.github/workflows/deploy.yml
index 8b2dc2e..cafcaf9 100644
--- a/.github/workflows/deploy.yml
+++ b/.github/workflows/deploy.yml
@@ -182,3 +182,68 @@ jobs:
             --region ${{ env.CLOUD_RUN_REGION }} \
             --format='value(status.conditions[0].status)' | grep -q True \
             || (echo "Worker service not in a healthy state" && exit 1)
+
+  # --- Frontend: Firebase Hosting, kept separate from the backend
+  # `deploy` job above on purpose — different toolchain (npm build, not
+  # a Docker image), different target (Firebase Hosting, not Cloud
+  # Run), and no reason a frontend deploy should wait on a backend one
+  # or vice versa. Before this job can succeed, one-time setup is
+  # needed — see docs/deployment/README.md's "Frontend CI deploy"
+  # section:
+  #   1. Grant the same service account GCP_SA_KEY already holds the
+  #      Firebase Hosting Admin role (it only has Cloud Run Admin +
+  #      Service Account User today):
+  #        gcloud projects add-iam-policy-binding <project-id> \
+  #          --member="serviceAccount:<sa-email>" \
+  #          --role="roles/firebasehosting.admin"
+  #   2. Add six repo secrets with the values from your own
+  #      frontend/.env.local (gitignored — never committed, unlike
+  #      frontend/.env.production.local which already holds
+  #      NEXT_PUBLIC_API_BASE_URL and needs no new secret):
+  #        gh secret set NEXT_PUBLIC_FIREBASE_API_KEY --body "..."
+  #        gh secret set NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN --body "..."
+  #        gh secret set NEXT_PUBLIC_FIREBASE_PROJECT_ID --body "..."
+  #        gh secret set NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET --body "..."
+  #        gh secret set NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID --body "..."
+  #        gh secret set NEXT_PUBLIC_FIREBASE_APP_ID --body "..."
+  deploy_frontend:
+    needs: test
+    runs-on: ubuntu-latest
+    if: github.ref == 'refs/heads/main'
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-node@v4
+        with:
+          node-version: "20"
+          cache: "npm"
+          cache-dependency-path: frontend/package-lock.json
+
+      - name: Install frontend dependencies
+        working-directory: frontend
+        run: npm ci
+
+      # NEXT_PUBLIC_API_BASE_URL isn't set here — Next.js auto-loads it
+      # from the already-committed frontend/.env.production.local
+      # during a production build, same as it would locally.
+      - name: Build static export
+        working-directory: frontend
+        env:
+          NEXT_PUBLIC_FIREBASE_API_KEY: ${{ secrets.NEXT_PUBLIC_FIREBASE_API_KEY }}
+          NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN: ${{ secrets.NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN }}
+          NEXT_PUBLIC_FIREBASE_PROJECT_ID: ${{ secrets.NEXT_PUBLIC_FIREBASE_PROJECT_ID }}
+          NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET: ${{ secrets.NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET }}
+          NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID: ${{ secrets.NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID }}
+          NEXT_PUBLIC_FIREBASE_APP_ID: ${{ secrets.NEXT_PUBLIC_FIREBASE_APP_ID }}
+        run: npm run build
+
+      # firebase.json (repo root) already points "public" at
+      # frontend/out, which `output: 'export'` in next.config.js just
+      # produced — nothing extra to configure here.
+      - name: Deploy to Firebase Hosting
+        uses: FirebaseExtended/action-hosting-deploy@v0
+        with:
+          repoToken: ${{ secrets.GITHUB_TOKEN }}
+          firebaseServiceAccount: ${{ secrets.GCP_SA_KEY }}
+          projectId: ${{ secrets.GCP_PROJECT_ID }}
+          channelId: live
