
# Self-serve YouTube connect (docs/decisions/0003-youtube-oauth-self-serve.md)
# Must point at the GATEWAY service (ai-carryon-gateway) — that's the one
# running uvicorn app.api.main:app, where oauth_youtube.py's routes live.
# The worker service (ai-carryon-worker) only runs Celery + a dummy health
# endpoint (see app/workers/worker_entrypoint.py) — it has no FastAPI routes
# at all, so pointing this at the worker's URL 404s every time.
# Get the real value with:
#   gcloud run services describe ai-carryon-gateway --project=<PROJECT_ID> \
#     --region=<REGION> --format='value(status.url)'
YOUTUBE_OAUTH_REDIRECT_URI=https://ai-carryon-gateway-590045983169.asia-south1.run.app/oauth/youtube/callback
# This exact URI must also be added as an Authorized redirect URI on the
# OAuth client in Google Cloud Console > APIs & Services > Credentials
# (the same client YOUTUBE_CLIENT_SECRETS_B64 is generated from) — Google
# rejects the callback with redirect_uri_mismatch otherwise.
FRONTEND_URL=https://your-frontend-domain.example
