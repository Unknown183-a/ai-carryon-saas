# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Web API Key — NOT the service account. Firebase console → Project
# settings → General → Web API Key. Only needed for tests that mint real
# ID tokens (tests/phase1_firebase_test.py's negative test,
# tests/phase6_real_keys_smoke_test.py) — the app itself never uses it.
FIREBASE_WEB_API_KEY=

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Rate limiter — optional, defaults to 30 if unset
RATE_LIMIT_REQUESTS_PER_MINUTE=

# Qdrant
QDRANT_URL=
QDRANT_API_KEY=

# Provider-key encryption at rest (Ch.12d) — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CHANNEL_SECRETS_ENCRYPTION_KEY=

# LLM providers
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# YouTube
YOUTUBE_CLIENT_SECRETS_B64=
YOUTUBE_TOKEN_B64=

# ElevenLabs
ELEVENLABS_API_KEY=
