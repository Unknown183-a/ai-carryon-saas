# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Rate limiter — optional, defaults to 30 if unset
RATE_LIMIT_REQUESTS_PER_MINUTE=

# Qdrant
QDRANT_URL=
QDRANT_API_KEY=

# Provider-key encryption at rest (Ch.12d) — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CHANNEL_SECRETS_ENCRYPTION_KEY=

# LLM providers
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# YouTube
YOUTUBE_CLIENT_SECRETS_B64=
YOUTUBE_TOKEN_B64=

# ElevenLabs
ELEVENLABS_API_KEY=

# Phase 7 — Celery broker (Ch.15). Same Upstash Redis database as
# UPSTASH_REDIS_REST_URL above, just its plain Redis-protocol connection
# string instead of the REST endpoint — see app/workers/celery_app.py's
# module docstring for why these are the same instance, two protocols.
# Find it in Upstash's dashboard under Connect -> Redis (not REST API).
CELERY_BROKER_URL=

# Phase 7 — local scratch dir for in-flight render artifacts (voice.mp3,
# thumbnail.png, final.mp4). Defaults to /tmp/ai_carryon_runs if unset —
# see app/workers/storage.py's module docstring for why this is a known,
# documented gap (local disk, not yet real cloud storage) rather than a
# finished multi-worker-safe design.
WORKER_OUTPUT_DIR=
