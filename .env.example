# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional — defaults to `<FIREBASE_PROJECT_ID>.appspot.com` if unset.
# Backs app/workers/storage.py's cross-worker artifact persistence
# (voice.mp3/thumbnail.png/clip_*.mp4/final.mp4 surviving a Cloud Run
# worker instance recycle mid-chain).
FIREBASE_STORAGE_BUCKET=

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Rate limiter — optional, defaults to 30 if unset
RATE_LIMIT_REQUESTS_PER_MINUTE=

# Qdrant
QDRANT_URL=
QDRANT_API_KEY=

# Provider-key encryption at rest (Ch.12d) — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CHANNEL_SECRETS_ENCRYPTION_KEY=

# LLM providers
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# YouTube
YOUTUBE_CLIENT_SECRETS_B64=
YOUTUBE_TOKEN_B64=

# ElevenLabs
ELEVENLABS_API_KEY=

# Phase 7 — Celery broker (Ch.15). Same Upstash Redis database as
# UPSTASH_REDIS_REST_URL above, just its plain Redis-protocol connection
# string instead of the REST endpoint — see app/workers/celery_app.py's
# module docstring for why these are the same instance, two protocols.
# Find it in Upstash's dashboard under Connect -> Redis (not REST API).
CELERY_BROKER_URL=

# Phase 7 — local scratch dir for in-flight render artifacts (voice.mp3,
# thumbnail.png, final.mp4). Defaults to /tmp/ai_carryon_runs if unset —
# see app/workers/storage.py's module docstring for why this is a known,
# documented gap (local disk, not yet real cloud storage) rather than a
# finished multi-worker-safe design.
WORKER_OUTPUT_DIR=

# Phase 8 — shared secret the Scheduler (Cloud Scheduler, or a plain cron
# job until Phase 9 picks a deploy target) presents instead of a Firebase
# user JWT when it calls POST /internal/scheduler/run-due-channels
# (Ch.16, Ch.12e's "system role token" case — see
# tenant_platform/security/permissions.py's require_system_token).
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_SCHEDULER_TOKEN=

# Phase 10 — Monitoring & Alerts (Ch.18-19). Resend for email delivery —
# see integrations/resend/client.py's module docstring for why Resend
# over Gmail SMTP/SendGrid. ALERT_EMAIL_FROM must be a domain verified
# in your Resend account; ALERT_EMAIL_TO is just wherever alerts should
# land (your own inbox, a team alias, etc.) — if unset, alert_agent.py
# still writes the Incident Report + dashboard Notification, it just
# skips the email step rather than failing the whole escalation.
RESEND_API_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
