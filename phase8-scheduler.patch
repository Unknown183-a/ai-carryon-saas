+# ── Fake embedding (bag-of-words, same trick as Phase 5/6's tests) ─────────
+import math  # noqa: E402
+import re as _re  # noqa: E402
+
+_VOCAB = ["ai", "coding", "assistants", "adoption", "developers", "topic", "research"]
